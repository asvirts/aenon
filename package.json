{
  "name": "aenon",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "server": "node scripts/season-passages.ts && node --env-file=.env src/server/passageServer.ts",
    "build": "node scripts/season-passages.ts && vite build",
    "preview": "vite preview",
    "test": "node scripts/season-passages.ts && node --test tests/**/*.test.ts",
    "typecheck": "node scripts/season-passages.ts && tsc --noEmit",
    "size": "node scripts/first-load-size.ts",
    "passages": "node scripts/season-passages.ts",
    "credits": "node scripts/art/credits.ts",
    "art:prepare-sample": "node scripts/art/prepare-compression-sample.mjs",
    "art:optimize": "node scripts/art/optimize.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/loaders": "^9.30.0",
    "phaser": "^4.2.1"
  }
